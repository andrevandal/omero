{
  "extends": "../../tsconfig.react.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "emitDeclarationOnly": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "paths": {
      ":templates/*": ["./src/templates/*"],
      "@omero/schemas": ["../schemas/src/index.ts"],
      "@omero/schemas/*": ["../schemas/src/*"],
      "@omero/utils": ["../utils/src/index.ts"],
      "@omero/utils/*": ["../utils/src/*"]
    }
  },
  "include": ["src", "../utils/**/*", "../schemas/**/*"],
  "references": [
    {
      "path": "../schemas"
    },
    {
      "path": "../utils"
    }
  ]
}
