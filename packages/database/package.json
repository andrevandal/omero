{
  "name": "@omero/database",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "generate": "drizzle-kit generate --config ./drizzle.config.ts",
    "migrate": "drizzle-kit migrate --config ./drizzle.config.ts",
    "studio": "drizzle-kit studio --config ./drizzle.config.ts",
    "seed": "node --experimental-strip-types ./seed/index.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "@omero/env": "workspace:^",
    "@omero/schemas": "workspace:^",
    "@omero/utils": "workspace:^",
    "add": "^2.0.6",
    "drizzle-orm": "^0.44.6"
  },
  "devDependencies": {
    "@noble/hashes": "^2.0.1"
  }
}
