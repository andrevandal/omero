{
  "extends": "../../tsconfig.options.json",
  "compilerOptions": {
    "types": ["@types/node"],
    "module": "NodeNext",
    "rootDir": "./src",
    "emitDeclarationOnly": true,
    "outDir": "./dist",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "paths": {
      ":schemas": ["./src/schemas/index.js"],
      ":seed/*": ["./src/seed/*"],
      "@omero/schemas": ["../schemas/src/index.ts"],
      "@omero/schemas/*": ["../schemas/src/*"],
      "@omero/utils": ["../utils/src/index.ts"],
      "@omero/utils/*": ["../utils/src/*"]
    }
  },
  "include": ["src", "../schemas/**/*", "../utils/**/*"],
  "references": [
    {
      "path": "../schemas"
    },
    {
      "path": "../utils"
    }
  ]
}
