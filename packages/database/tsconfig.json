{
  "extends": "../../tsconfig.options.json",
  "compilerOptions": {
    "module": "NodeNext",
    "rootDir": ".",
    "emitDeclarationOnly": true,
    "outDir": "./dist",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "paths": {
      ":schemas": ["./src/schemas/index.js"],
      ":seed/*": ["./src/seed/*"],
      ":env": ["./src/env.js"],
      "@omero/env": ["../env/src/index.ts"],
      "@omero/env/*": ["../env/src/*"],
      "@omero/schemas": ["../schemas/src/index.ts"],
      "@omero/schemas/*": ["../schemas/src/*"],
      "@omero/utils": ["../utils/src/index.ts"],
      "@omero/utils/*": ["../utils/src/*"]
    }
  },
  "include": [
    "drizzle.config.ts",
    "src",
    "../env/**/*",
    "../schemas/**/*",
    "../utils/**/*"
  ],
  "references": [
    {
      "path": "../env"
    },
    {
      "path": "../schemas"
    },
    {
      "path": "../utils"
    }
  ]
}
