{
  "name": "omero",
  "version": "1.0.0",
  "description": "Omero: The Erudite Headless CMS",
  "type": "module",
  "scripts": {
    "test": "vitest",
    "update": "pnpm update -i -r --latest",
    "sync": "moon sync",
    "types": "moon run :typecheck",
    "clean": "find packages -type f -name 'tsconfig.tsbuildinfo' -delete; find packages -type d -name 'dist' | xargs rm -rf",
    "format": "prettier --check --cache .",
    "format:fix": "prettier --write --cache .",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "lint:fix": "eslint --fix --cache --cache-location ./node_modules/.cache/eslint ."
  },
  "keywords": [],
  "author": "André Vandal <me@andrevandal.dev>",
  "license": "ISC",
  "pnpm": {
    "overrides": {
      "vite": "npm:rolldown-vite@7.1.12"
    },
    "onlyBuiltDependencies": [
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@eslint/css": "^0.11.1",
    "@eslint/js": "^9.37.0",
    "@prettier/plugin-oxc": "^0.0.4",
    "@types/node": "^24.5.2",
    "drizzle-kit": "^0.31.5",
    "eslint": "9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-next": "^0.6.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-sonarjs": "^3.0.5",
    "eslint-plugin-unicorn": "^61.0.2",
    "globals": "^16.4.0",
    "happy-dom": "^12.10.3",
    "markdownlint": "^0.38.0",
    "prettier-plugin-sh": "^0.18.0",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "simple-git-hooks": "^2.13.1",
    "tailwind-csstree": "^0.1.4",
    "tsconfig-moon": "^1.4.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": "~24",
    "pnpm": ">=10"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpx lint-staged@latest"
  },
  "sideEffects": false,
  "lint-staged": {
    "!(*.(t|j)s(x)?)": "prettier --write",
    "*.(t|j)s(x)?": [
      "eslint --fix --cache --cache-location ./node_modules/.cache/eslint",
      "prettier --cache --write"
    ]
  }
}
