{
  "name": "omero",
  "version": "1.0.0",
  "description": "Omero: The Erudite Headless CMS",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/**"
  ],
  "scripts": {
    "test": "vitest",
    "update": "bun update -i -r --latest",
    "sync": "moon sync",
    "types": "moon run :types",
    "clean": "find packages -type f -name 'tsconfig.tsbuildinfo' -delete; find packages -type d -name 'dist' | xargs rm -rf",
    "format": "prettier --check --cache .",
    "format:fix": "prettier --write --cache .",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "lint:fix": "eslint --fix --cache --cache-location ./node_modules/.cache/eslint .",
    "db:generate": "drizzle-kit generate --config ./drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config ./drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config ./drizzle.config.ts",
    "db:seed": "node --experimental-strip-types ./packages/database/seed/index.ts"
  },
  "keywords": [],
  "author": "André Vandal <me@andrevandal.dev>",
  "license": "MIT",
  "overrides": {
    "vite": "npm:rolldown-vite@7.1.12"
  },
  "devDependencies": {
    "@eslint/compat": "^1.4.0",
    "@eslint/css": "^0.13.0",
    "@eslint/css-tree": "^3.6.6",
    "@eslint/js": "^9.37.0",
    "@omero/database": "workspace:",
    "@omero/notifications": "workspace:",
    "@omero/utils": "workspace:",
    "@prettier/plugin-oxc": "^0.0.4",
    "@sindresorhus/slugify": "^3.0.0",
    "@types/bun": "^1.3.0",
    "@types/node": "^24.7.2",
    "@typescript-eslint/parser": "^8.46.0",
    "drizzle-kit": "^0.31.5",
    "eslint": "9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-next": "^0.6.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-sonarjs": "^3.0.5",
    "eslint-plugin-unicorn": "^61.0.2",
    "globals": "^16.4.0",
    "happy-dom": "^12.10.3",
    "markdownlint": "^0.38.0",
    "prettier": "^3.6.2",
    "prettier-plugin-sh": "^0.18.0",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "simple-git-hooks": "^2.13.1",
    "tailwind-csstree": "^0.1.4",
    "tsconfig-moon": "^1.4.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": "~24",
    "bun": "^1.3"
  },
  "simple-git-hooks": {
    "pre-commit": "bunx lint-staged@latest"
  },
  "sideEffects": false,
  "lint-staged": {
    "!(*.(t|j)s(x)?)": "prettier --write",
    "*.(t|j)s(x)?": [
      "eslint --fix --cache --cache-location ./node_modules/.cache/eslint",
      "prettier --cache --write"
    ]
  },
  "catalog": {
    "vitest": "^3.2.4",
    "typescript": "^5.9.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "@types/react": "^19.1.15",
    "@types/bun": "^1.3.0",
    "@types/node": "^24.7.2"
  }
}
